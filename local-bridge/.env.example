# Copy to .env and uncomment what you need. Everything is optional.
# With no .env at all, chat uses your Claude Code login and voice uses macOS `say`.

# --- Claude (via your Claude Code login) ---
# Force one model regardless of the app's Sonnet/Opus picker (alias or full id).
# CLICKY_CLAUDE_MODEL=haiku
# Effort level passed to `claude --effort` (low, medium, high, xhigh, max).
# CLICKY_CLAUDE_EFFORT=low
# Extended thinking is off for voice turns because it adds seconds of silence
# before Clicky starts talking. Set to 1 to turn it back on.
# CLICKY_CLAUDE_THINKING=1
# Path to the claude CLI if it isn't found automatically.
# CLAUDE_BIN=/opt/homebrew/bin/claude

# --- Voice output ---
# macOS voice for `say` (list them with: say -v '?'). Premium voices sound much better:
# System Settings → Accessibility → Spoken Content → System voice → Manage Voices.
# CLICKY_SAY_VOICE=Samantha
# CLICKY_SAY_RATE=200
# Set both of these to use ElevenLabs instead of `say`:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=kPzsL2i3teMYv0FxEYQ6

# --- Voice input ---
# Only needed if you switch VoiceTranscriptionProvider back to "assemblyai" in Info.plist.
# ASSEMBLYAI_API_KEY=

# CLICKY_BRIDGE_PORT=8787
